#!include "examples/include/std.lang"

#!linker.framework "Cocoa"
#!linker.framework "OpenGL"
#!linker.framework "IOKit"
#!linker.framework "CoreVideo"
#!linker.framework "AppKit"
#!linker.library "raylib"

struct Color{
    char r
    char g
    char b
    char a
}


void InitWindow(int width, int height, string title);
int WindowShouldClose();
void BeginDrawing();
void EndDrawing();
void CloseWindow();
void SetTargetFPS(int fps)
void ClearBackground(struct Color color);
void DrawText(string text, int posX, int posY, int fontSize, struct Color color);


void DrawCircle(int centerX, int centerY, float radius, struct Color color);


int IsKeyPressed(int key);
int IsKeyDown(int key);

void DrawRectangleGradientV(int posX, int posY, int width, int height, struct Color color1, struct Color color2);


int main(){
    InitWindow(800, 600, "Hello World")
    SetTargetFPS(60);


    struct Color color
    color.r = 255
    color.g = 255
    color.b = 255
    color.a = 255

    struct Color color2
    color2.r = 0
    color2.g = 0
    color2.b = 0
    color2.a = 255

    struct Color redColor
    redColor.r = 255
    redColor.g = 0
    redColor.b = 0
    redColor.a = 255

    struct Color greenColor
    greenColor.r = 0
    greenColor.g = 255
    greenColor.b = 0
    greenColor.a = 255

    struct Color blueColor
    blueColor.r = 0
    blueColor.g = 0
    blueColor.b = 255
    blueColor.a = 255


    while (WindowShouldClose() == 0){
        BeginDrawing()

        ClearBackground(color)


        DrawRectangleGradientV(0, 0, 800, 600, greenColor, blueColor)

        // DrawText("Welcome to BirdSharp!", 70, 200, 60, color2)

        EndDrawing()
    }
    CloseWindow()
    return 0
}
