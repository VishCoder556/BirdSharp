string int_to_string(int num){
    ptr<char> str = cast(ptr<char>, malloc(200));

    int temp = num;
    int j = 0;
    if (num < 0) {
        temp = 0 - temp;
    }

    if (num == 0){
        deref(str) = cast(char, 48);
        deref(str + cast(ptr<char>, 1)) = cast(char, 0);
        return cast(string, str);
    }

    while (temp != 0) {
        int t = temp % 10;
        deref(str + cast(ptr<char>, j)) = cast(char, t + 48);
        temp = temp / 10;
        j = j + 1;
    }

    if (num < 0) {
        deref(str + cast(ptr<char>, j)) = cast(char, 45); // '-'
        j = j + 1;
    }

    deref(str + cast(ptr<char>, j)) = cast(char, 0);

    int end = j - 1;
    int begin = 0;
    while (begin < end) {
        char temp_char = deref(str + cast(ptr<char>, begin));
        deref(str + cast(ptr<char>, begin)) = deref(str + cast(ptr<char>, end));
        deref(str + cast(ptr<char>, end)) = temp_char;
        begin = begin + 1;
        end = end - 1;
    }

    return cast(string, str);
}


int main(){
    int width = 800
    int height = 600
    InitWindow(width, height, "Hello World")
    SetTargetFPS(60);


    struct Color color
    color.r = 255
    color.g = 255
    color.b = 255
    color.a = 255

    struct Color color2
    color2.r = 0
    color2.g = 0
    color2.b = 0
    color2.a = 255

    struct Color redColor
    redColor.r = 255
    redColor.g = 0
    redColor.b = 0
    redColor.a = 255

    struct Color greenColor
    greenColor.r = 0
    greenColor.g = 255
    greenColor.b = 0
    greenColor.a = 255

    struct Color blueColor
    blueColor.r = 0
    blueColor.g = 0
    blueColor.b = 255
    blueColor.a = 255


    while (WindowShouldClose() == 0){
        BeginDrawing()

        ClearBackground(color)


        DrawRectangleGradientH(0, 0, 800, 600, greenColor, blueColor)

        int mouseX = GetMouseX()
        int mouseY = GetMouseY()
        if (mouseX < width && mouseY < height){
            string str = cast(string, malloc(20))
            snprintf(str, 20, "{x: %d, y: %d}", mouseX, mouseY)
            DrawText(str, 70, 300, 60, color2)
        }

        EndDrawing()
    }
    CloseWindow()
    return 0
}
