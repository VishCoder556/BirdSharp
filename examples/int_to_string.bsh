#!include "examples/include/std.bsh"

string int_to_string(int num){
    ptr<char> str = cast(ptr<char>, malloc(200));

    int temp = num;
    int j = 0;
    if (num < 0) {
        temp = 0 - temp;
    }

    if (num == 0){
        deref(str) = cast(char, 48);
        deref(str + cast(ptr<char>, 1)) = cast(char, 0);
        return cast(string, str);
    }

    while (temp != 0) {
        int t = temp % 10;
        deref(str + cast(ptr<char>, j)) = cast(char, t + 48);
        temp = temp / 10;
        j = j + 1;
    }

    if (num < 0) {
        deref(str + cast(ptr<char>, j)) = cast(char, 45); // '-'
        j = j + 1;
    }

    deref(str + cast(ptr<char>, j)) = cast(char, 0);

    int end = j - 1;
    int begin = 0;
    while (begin < end) {
        char temp_char = deref(str + cast(ptr<char>, begin));
        deref(str + cast(ptr<char>, begin)) = deref(str + cast(ptr<char>, end));
        deref(str + cast(ptr<char>, end)) = temp_char;
        begin = begin + 1;
        end = end - 1;
    }

    return cast(string, str);
}

int main(int argc, int argv){
    printf("%s\n", int_to_string(3 + 2))
    return 0
}
